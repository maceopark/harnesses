+    initialized_linter: PyLinter, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    initialized_linter.config.ignore_paths = [re.compile(r"^src/gen/.*$")]
+    monkeypatch.setattr(os.path, "isdir", lambda path: path == "src/")
+    monkeypatch.setattr(os.path, "isfile", lambda _: False)
