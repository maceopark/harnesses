+def _is_in_ignore_list_re_paths(
+    element: str, ignore_list_re: list[Pattern[str]]
+) -> bool:
+    """Determine if a path is matched in a regex ignore-list.
+
+    Paths can contain mixed separators when a user-supplied path is combined with
+    paths discovered by the operating system. Keep the original representation
+    for backwards compatibility and also try consistently separated forms.
+    """
+    def _replace_separator(match: Match[str], separator: str) -> str:
+        if match.start() == 0 and len(match.group()) > 1:
+            return separator * 2
+        return separator
+
+    candidates = (
+        element,
+        sub(r"[\\/]+", lambda match: _replace_separator(match, "/"), element),
+        sub(r"[\\/]+", lambda match: _replace_separator(match, "\\"), element),
+    )
+    return any(
+        file_pattern.match(candidate)
+        for file_pattern in ignore_list_re
+        for candidate in candidates
+    )
+
