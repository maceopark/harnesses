{
  "schema": "SWEbenchV0DecisionEvolutionStudy.v1",
  "baseline": "skills/v0-SKILL.md",
  "candidate_limit": 1,
  "generation_limit": 1,
  "mutation_signal": "every development implementation decision.jsonl row",
  "ideal_signal": "decision.jsonl absent",
  "partitions": {
    "train": {"source": "development", "cases": 8, "max_concurrency": 8},
    "test": {"source": "validation", "cases_per_arm": 3, "arms": 2, "max_concurrency": 6},
    "holdout": {"source": "holdout", "cases": 4, "max_concurrency": 4, "reused": true}
  },
  "phase_order": ["train", "mutation", "test", "holdout"],
  "inputs": {
    "sealed_approved": "inputs/sealed/approved-pilot-sealed.json",
    "corpus": "inputs/corpus",
    "cache": "cache",
    "repositories": "repositories"
  },
  "outputs": {
    "runs": "runs",
    "candidate": "runs/batch-mutation/candidate-SKILL.md",
    "decision": "decision.json",
    "verification": "verification.json"
  },
  "result": {
    "status": "completed",
    "verified": true,
    "development_decisions": 0,
    "all_successful_run_decisions": 1,
    "all_failed_attempt_decisions": 0,
    "all_decisions_reviewed": true,
    "skill_gap_decisions": 1,
    "mutation_performed": false,
    "candidate_equals_baseline": true,
    "validation_winner": "baseline",
    "holdout_decisions": 0,
    "promotion_eligible": false,
    "promoted": false
  }
}
