     assert module in linted_file_paths
 
 
+@pytest.mark.parametrize("absolute_target", [False, True])
+def test_recursive_ignore_paths_from_pyproject(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, absolute_target: bool
+) -> None:
+    """CWD-relative ignore-paths apply during recursive discovery."""
+    src = tmp_path / "src"
+    generated = src / "gen"
+    generated.mkdir(parents=True)
+    (src / "included.py").write_text('"""Included module."""\n', encoding="utf-8")
+    (generated / "ignored.py").write_text(
+        '"""Ignored module."""\n', encoding="utf-8"
+    )
+    (tmp_path / "pyproject.toml").write_text(
+        '[tool.pylint.MASTER]\nignore-paths = ["^src/gen/.*$"]\n',
+        encoding="utf-8",
+    )
+    monkeypatch.chdir(tmp_path)
+    target = str(src) if absolute_target else "src"
+
+    run = lint.Run(["--recursive=y", "--disable=all", target], exit=False)
+
+    linted_modules = set(run.linter.stats.by_module)
+    assert "included" in linted_modules
+    assert "ignored" not in linted_modules
+
+
