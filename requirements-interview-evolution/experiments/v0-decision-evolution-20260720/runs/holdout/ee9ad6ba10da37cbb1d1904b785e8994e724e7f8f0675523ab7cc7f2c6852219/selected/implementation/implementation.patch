+    def test_modify_sys_path_only_removes_current_directory_markers() -> None:
+        cwd = "/current/directory"
+        unrelated = "/injected/path"
+        with _test_sys_path(), patch("os.getcwd", return_value=cwd):
+            for marker in ("", ".", cwd):
+                sys.path = [marker, unrelated]
+                with _test_environ_pythonpath():
+                    modify_sys_path()
+                assert sys.path == [unrelated]
+
+            sys.path = [unrelated]
+            with _test_environ_pythonpath():
+                modify_sys_path()
+            assert sys.path == [unrelated]
+
+            sys.path = []
+            with _test_environ_pythonpath():
+                modify_sys_path()
+            assert sys.path == []
