+def test_show_fixtures_with_bytes_parameter(testdir, mode):
+    p = testdir.makepyfile(
+        """
+        import pytest
+        @pytest.mark.parametrize('data', [b'Hello World'])
+        def test_data(data):
+            pass
+        """
+    )
+
+    result = testdir.runpytest(mode, "-W", "error::BytesWarning", p)
+    assert result.ret == 0
+    result.stdout.fnmatch_lines(
+        [
+            "*SETUP    F data?b'Hello World'?*",
+            "*TEARDOWN F data?b'Hello World'?*",
+        ]
+    )
+
+
+def test_show_fixtures_with_broken_repr_parameter(testdir, mode):
+    p = testdir.makepyfile(
+        """
+        import pytest
+        class BrokenRepr:
+            def __repr__(self):
+                raise RuntimeError('cannot represent')
+        @pytest.fixture(params=[BrokenRepr()])
+        def data(request):
+            return request.param
+        def test_data(data):
+            pass
+        """
+    )
+
+    result = testdir.runpytest(mode, p)
+    assert result.ret == 0
+    result.stdout.fnmatch_lines(
+        [
+            "*SETUP    F data?*BrokenRepr object at *",
+            "*TEARDOWN F data?*BrokenRepr object at *",
         ]
     )
 
