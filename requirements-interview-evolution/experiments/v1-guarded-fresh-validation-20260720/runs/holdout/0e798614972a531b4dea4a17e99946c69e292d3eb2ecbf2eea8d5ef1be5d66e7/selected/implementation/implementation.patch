+@pytest.mark.parametrize("path_separator", ["/", "\\"])
+def test_recursive_ignore_paths_from_config(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, path_separator: str
+) -> None:
+    src = tmp_path / "src"
+    create_files(
+        [
+            str(src / "included.py"),
+            str(src / "gen" / "ignored.py"),
+        ]
+    )
+    ignore_path = path_separator.join(("^src", "gen", ".*$"))
+    (tmp_path / "pyproject.toml").write_text(
+        f"[tool.pylint.MASTER]\nignore-paths = ['{ignore_path}']\n",
+        encoding="utf-8",
+    )
+    monkeypatch.chdir(tmp_path)
+
+    run = Run(
+        ["--rcfile", "pyproject.toml", "--recursive", "y", "src"], exit=False
+    )
+    linted_files = run.linter._iterate_file_descrs(
+        tuple(run.linter._discover_files(["src"]))
+    )
+    linted_file_paths = {Path(item.filepath).resolve() for item in linted_files}
+
+    assert (src / "gen" / "ignored.py").resolve() not in linted_file_paths
+    assert (src / "included.py").resolve() in linted_file_paths
+
+
