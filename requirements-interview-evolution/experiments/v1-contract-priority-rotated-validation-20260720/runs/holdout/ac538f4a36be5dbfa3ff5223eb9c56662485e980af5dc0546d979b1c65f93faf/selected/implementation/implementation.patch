+def test_show_fixtures_with_bytes_parameter(testdir):
+    p = testdir.makepyfile(
+        """
+        import pytest
+        @pytest.mark.parametrize('data', [b'Hello World'])
+        def test_data(data):
+            pass
+    """
+    )
+
+    result = testdir.run(sys.executable, "-bb", "-m", "pytest", "--setup-show", p)
+
+    assert result.ret == 0
+    result.stdout.fnmatch_lines(
+        ["*SETUP    F data?b'Hello World'?", "*TEARDOWN F data?b'Hello World'?"]
+    )
+
+
+def test_show_fixtures_with_long_parameter_repr(testdir):
+    testdir.makepyfile(
+        """
+        import pytest
+        @pytest.fixture(params=['x' * 1000])
+        def data(request):
+            return request.param
+        def test_data(data):
+            pass
+    """
+    )
+
+    result = testdir.runpytest("--setup-show")
+
+    assert result.ret == 0
+    setup_line = next(line for line in result.stdout.lines if "SETUP    F data[" in line)
+    assert "..." in setup_line
+    assert len(setup_line) < 300
+
+
+def test_show_fixtures_with_broken_parameter_repr(testdir):
+    testdir.makepyfile(
+        """
+        import pytest
+        class BrokenRepr:
+            def __repr__(self):
+                raise ValueError('broken repr')
+        @pytest.fixture(params=[BrokenRepr()])
+        def data(request):
+            return request.param
+        def test_data(data):
+            pass
+    """
+    )
+
+    result = testdir.runpytest("--setup-show")
+
+    assert result.ret == 0
+    result.stdout.fnmatch_lines(
+        ["*SETUP    F data?*raised in repr()*", "*TEARDOWN F data?*raised in repr()*"]
+    )
+
