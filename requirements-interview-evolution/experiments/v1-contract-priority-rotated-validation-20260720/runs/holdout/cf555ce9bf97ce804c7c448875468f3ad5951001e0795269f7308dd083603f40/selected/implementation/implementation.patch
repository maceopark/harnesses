+def test_does_not_collect_init_only_package(testdir):
+    pkg = testdir.mkpydir("pkg")
+    pkg.join("__init__.py").write("raise RuntimeError('not importable')")
+    testdir.makepyfile("def test_passes(): pass")
+
+    result = testdir.runpytest()
+
+    result.stdout.fnmatch_lines(["*1 passed in*"])
+    assert result.ret == 0
+
+
+def test_collect_test_module_below_nonmatching_init(testdir):
+    pkg = testdir.mkpydir("pkg")
+    pkg.join("test_module.py").write("def test_passes(): pass")
+
+    result = testdir.runpytest("--collect-only", "-q")
+
+    result.stdout.fnmatch_lines(["pkg/test_module.py::test_passes", "*1 test collected*"])
+    assert result.ret == 0
+
