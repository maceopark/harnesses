     assert module in linted_file_paths
 
 
+@pytest.mark.parametrize(
+    "ignore_path", (r"^src/gen/.*$", r"^src\\gen\\.*$")
+)
+def test_recursive_ignore_paths_relative_to_cwd(
+    initialized_linter: PyLinter, tmp_path: Path, monkeypatch, ignore_path: str
+) -> None:
+    """Recursive ignore-paths also match paths relative to the invocation cwd."""
+    monkeypatch.chdir(tmp_path)
+    create_files(["src/kept.py", "src/gen/ignored.py"])
+    initialized_linter.set_option("ignore-paths", [ignore_path])
+
+    discovered = list(initialized_linter._discover_files(["src"]))
+
+    assert os.path.join("src", "kept.py") in discovered
+    assert os.path.join("src", "gen", "ignored.py") not in discovered
+
+
