{
  "schema": "DriftbenchWorkerOciProfile.v2",
  "name": "contract-drift-offline-linux-arm64-worker",
  "platform": {
    "os": "linux",
    "architecture": "arm64"
  },
  "image": {
    "dockerfile": "Dockerfile.worker",
    "base": {
      "registry": "docker.io",
      "repository": "library/python",
      "tag": "3.14-slim",
      "digest": "sha256:8b48630e688730a22bd25f3c9e04606b37fa1488cf70e665932ef78a3ee1e4d0",
      "reference": "docker.io/library/python@sha256:8b48630e688730a22bd25f3c9e04606b37fa1488cf70e665932ef78a3ee1e4d0",
      "resolved_platform": {
        "os": "linux",
        "architecture": "arm64",
        "variant": "v8"
      },
      "resolved_at": "2026-07-12"
    },
    "entrypoint": [
      "driftbench"
    ],
    "user": {
      "uid": 10001,
      "gid": 10001,
      "name": "worker"
    }
  },
  "build": {
    "lockfile": "requirements.worker.lock",
    "uv_lockfile": "uv.lock",
    "wheelhouse": "wheelhouse",
    "wheelhouse_manifest": "wheelhouse/manifest.json",
    "offline": true,
    "require_hashes": true,
    "allow_source_distributions": false
  },
  "frozen_assets": [
    {
      "source": "corpus/public",
      "destination": "/opt/driftbench/corpus/public",
      "read_only": true
    },
    {
      "source": "oci",
      "destination": "/opt/driftbench/oci",
      "read_only": true
    },
    {
      "source": "protocol/ultimateinterview/ui-native-77b0327-r4",
      "destination": "/opt/driftbench/protocol/ultimateinterview/ui-native-77b0327-r4",
      "read_only": true
    }
  ],
  "runtime": {
    "read_only_root_filesystem": true,
    "network": {
      "mode": "none",
      "allow_host_network": false,
      "allow_dns": false
    },
    "privileges": {
      "allow_privileged": false,
      "no_new_privileges": true,
      "capabilities": {
        "drop": [
          "ALL"
        ],
        "add": []
      },
      "seccomp": {
        "profile": "oci/seccomp.worker.json",
        "sha256": "c0734410267967eada858ab7699b5d4fbd8fdb7e9f2c3f14c123182838d75920",
        "required": true
      }
    },
    "mount_policy": {
      "allow_bind_mounts": false,
      "allow_host_home": false,
      "allow_socket_mounts": false,
      "allow_private_corpus": false,
      "allow_additional_mounts": false,
      "allowed_mount_types": [
        "tmpfs",
        "named-volume"
      ],
      "role_capabilities": "oci/role-capabilities.v1.json",
      "tmpfs": [
        {
          "destination": "/tmp",
          "size_bytes": 67108864,
          "mode": "1777",
          "options": [
            "noexec",
            "nodev",
            "nosuid"
          ]
        }
      ],
      "workspace": {
        "type": "named-volume",
        "source_prefix": "driftbench-workspace-",
        "destination_prefix": "/workspace/",
        "copy_data": true
      }
    },
    "resources": {
      "pids_max": 64,
      "memory_bytes": 536870912,
      "cpu_max": {
        "quota_us": 100000,
        "period_us": 100000
      },
      "ulimits": {
        "nofile": {
          "soft": 1024,
          "hard": 1024
        }
      }
    }
  },
  "receipt": {
    "schema": "WorkerIsolationLaunchReceipt.v1",
    "required_controls": [
      "network",
      "read_only_root_filesystem",
      "nonroot_user",
      "capabilities",
      "no_new_privileges",
      "seccomp",
      "resources",
      "mounts"
    ]
  },
  "live_mode": {
    "external_capabilities_required": [
      "provider.invoke.v1",
      "simulator.execute.v1",
      "evaluator.score.v1"
    ],
    "worker_must_not_receive": [
      "provider.credentials",
      "simulator.private-corpus",
      "evaluator.private-oracle"
    ]
  }
}
